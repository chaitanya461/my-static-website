option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeVersion: 18
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production

files:
  "/etc/nginx/conf.d/01_static.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      location / {
        try_files $uri $uri/ /index.html;
      }
